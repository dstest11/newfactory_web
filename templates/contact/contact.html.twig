{% extends 'base.html.twig' %}

{% block title %}Kontakt — New Factory{% endblock %}

{% block body %}
<div class="nf-shell">
<header class="nf-header">
    <a href="{{ path('home') }}" class="nf-header__brand">
        <span class="nf-display">NEW</span><span class="nf-display nf-display--accent">FACTORY</span>
    </a>
    <nav class="nf-header__nav">
        <a href="{{ path('home') }}"><span class="nf-mono">[01]</span> Úvod</a>
        <a href="{{ path('product_list') }}"><span class="nf-mono">[02]</span> Stroje</a>
        <a href="{{ path('contact') }}" class="is-active"><span class="nf-mono">[03]</span> Kontakt</a>
    </nav>
</header>

<main id="main" class="nf-page nf-page--contact">
    <section class="nf-page__intro nf-page__intro--contact">
        <p class="nf-eyebrow">[KONTAKT&nbsp;/&nbsp;NEZÁVAZNÁ&nbsp;POPTÁVKA]</p>
        <h1 class="nf-display nf-page__title">Pošlete nám<br><span class="nf-display--accent">poptávku.</span></h1>
        <p class="nf-page__lead-text">Ozveme se vám do <strong>24 hodin</strong>. Vše konzultujeme bezplatně — ROI kalkulace, výběr stroje, daňové konsekvence, tarif elektřiny.</p>
        <ul class="nf-contact__channels">
            <li><span class="nf-mono">@</span> <strong>E-mail:</strong> <a href="mailto:mining@new-factory.cz">mining@new-factory.cz</a></li>
            {# Telefonní číslo zatím skryto — `+420 777 123 456` byl placeholder. Až bude reálné, nahraď href + popisek a odstraň {% if false %}. #}
            {% if false %}
                <li><span class="nf-mono">☎</span> <strong>Telefon:</strong> <a href="tel:+420777123456">+420 777 123 456</a></li>
            {% endif %}
        </ul>
    </section>

    <section class="nf-contact__form-wrap">
        {# Same approach as dosmart_web/mikamiho_web: plain form → fetch() POST to
           the JSON endpoint → inline success/error (no full-page reload). #}
        <form id="contactForm" class="nf-contact__form" method="post" action="{{ path('contact_submit') }}" novalidate>
            <p class="nf-eyebrow nf-contact__form-eyebrow">[FORMULÁŘ]</p>
            {# Honeypot — visually hidden but present in DOM. Bots fill all fields. #}
            <div style="position: absolute; left: -9999px;" aria-hidden="true">
                <label>Leave this blank<input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <div>
                <label for="cf-name">Jméno</label>
                <input type="text" id="cf-name" name="name" required>
            </div>
            <div>
                <label for="cf-email">E-mail</label>
                <input type="email" id="cf-email" name="email" required>
            </div>
            <div>
                <label for="cf-phone">Telefon</label>
                <input type="tel" id="cf-phone" name="phone">
            </div>
            <div>
                <label for="cf-product">Zájem o produkt</label>
                <input type="text" id="cf-product" name="product" value="{{ product }}">
            </div>
            <div>
                <label for="cf-message">Zpráva</label>
                <textarea id="cf-message" name="message" rows="5"></textarea>
            </div>
            <button type="submit" class="nf-btn nf-btn--primary nf-btn--xl">Odeslat poptávku →</button>
            <p id="contact-form-status" role="status" aria-live="polite" style="display:none;"></p>
        </form>
    </section>
</main>

<footer class="nf-footer">
    <p><span class="nf-mono">©&nbsp;{{ "now"|date("Y") }}</span> New Factory &nbsp;·&nbsp; <a href="mailto:mining@new-factory.cz">mining@new-factory.cz</a></p>
    <p class="nf-footer__meta nf-mono">[BTC&nbsp;ASIC&nbsp;DISTRIBUTOR&nbsp;·&nbsp;CZ]</p>
</footer>
</div>

<script>
    // Contact form — client validation + server submit via fetch with an inline
    // success/error message (no page reload). Same approach as dosmart_web.
    (function () {
        var form = document.getElementById('contactForm');
        if (!form) return;
        var statusEl = document.getElementById('contact-form-status');
        var btn = form.querySelector('button[type="submit"]');

        function setStatus(msg, ok) {
            statusEl.textContent = msg;
            statusEl.style.display = 'block';
            statusEl.style.color = ok ? '#3ad07a' : '#ff6b6b';
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var name = document.getElementById('cf-name');
            var email = document.getElementById('cf-email');
            [name, email].forEach(function (i) { i.style.borderColor = ''; });

            var bad = false;
            if (!name.value.trim()) { name.style.borderColor = '#ff6b6b'; bad = true; }
            if (!email.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) { email.style.borderColor = '#ff6b6b'; bad = true; }
            if (bad) {
                setStatus('Vyplňte prosím jméno a platný e-mail.', false);
                var firstBad = form.querySelector('[style*="border-color"]');
                if (firstBad) firstBad.focus();
                return;
            }

            btn.disabled = true;
            var label = btn.textContent;
            btn.textContent = 'Odesílám…';
            statusEl.style.display = 'none';

            fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'X-Requested-With': 'fetch' } })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
                .then(function (res) {
                    if (res.ok && res.data && res.data.ok) {
                        form.reset();
                        setStatus(res.data.message || 'Děkujeme! Ozveme se vám do 24 hodin.', true);
                    } else {
                        setStatus((res.data && res.data.message) || 'Odeslání se nezdařilo. Napište nám na mining@new-factory.cz.', false);
                    }
                })
                .catch(function () {
                    setStatus('Spojení selhalo. Napište nám prosím na mining@new-factory.cz.', false);
                })
                .finally(function () { btn.disabled = false; btn.textContent = label; });
        });
    })();
</script>
{% endblock %}

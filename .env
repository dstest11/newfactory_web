# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> dstest11/mail-http-sdk ###
# Real key injected via webhook deploy → .env.local (the SHARED mail-http-api
# key — only the ?source= audit label differs per app). Dev: .env.local
# overrides MAILER_DSN to null://null so local never hits ell06.
NEWFACTORY_MAIL_RELAY_API_KEY=set_at_runtime_via_env
###< dstest11/mail-http-sdk ###

###> symfony/mailer ###
# MAIL POLICY (all doSMART apps): send ONLY via dstest11/mail-http-sdk →
# mail-http-api on ell06.vas-server.cz. DigitalOcean BLOCKS the outbound SMTP
# ports to our mail server, so a direct SMTP transport does NOT work from the
# droplet. ?source=newfactory_web identifies us in mail_log. To switch transports
# later, comment the mail-relay line and uncomment an SMTP DSN (not on DO).
MAILER_DSN=mail-relay+https://${NEWFACTORY_MAIL_RELAY_API_KEY}@ell06.vas-server.cz/?source=newfactory_web
# MAILER_DSN=smtp://USER:PASS@mail.example.com:465   # DISABLED — DigitalOcean blocks SMTP ports
###< symfony/mailer ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> newfactory/inline-edit ###
# Inline-edit admin credentials. Production values come from GH Secrets via
# deploy.sh::override_env_var(). Empty defaults disable the admin login entirely.
#   - NEWFACTORY_EDITOR_EMAILS: CSV of editor email addresses (must use lowercase canonical form)
#   - NEWFACTORY_EDITOR_PASSWORD_HASH: bcrypt hash of the shared editor password
NEWFACTORY_EDITOR_EMAILS=
NEWFACTORY_EDITOR_PASSWORD_HASH=
###< newfactory/inline-edit ###
